# RippleWatch Environment Configuration

# SerpApi API Key (Required for live market searches)
# Get your key at https://serpapi.com
SERPAPI_KEY=your_serpapi_api_key_here

# Google Gemini API Key (Optional)
# If provided, powers the AI Action Brief via the google-genai SDK.
# If omitted or if calls fail, RippleWatch automatically falls back to a deterministic rule-based brief.
GEMINI_API_KEY=your_gemini_api_key_here

# Backend settings
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./ripplewatch.db
CACHE_DIR=./cache
CACHE_TTL_HOURS=24
